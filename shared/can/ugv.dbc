 SG_ LeftTarget : 16|16@1- (1,0) [-32768|32767] "rpm" STM32_LEFT
 SG_ RightTarget : 32|16@1- (1,0) [-32768|32767] "rpm" STM32_RIGHT
 SG_ Limit : 48|8@1+ (1,0) [0|255] "%" STM32_LEFT,STM32_RIGHT
 SG_ Reserved : 56|8@1+ (1,0) [0|255] "" STM32_LEFT,STM32_RIGHT

BO_ 272 SystemEnable: 2 RPI
 SG_ Enabled : 0|8@1+ (1,0) [0|1] "" STM32_LEFT,STM32_RIGHT,ESP32_AUX
 SG_ EmergencyStop : 8|8@1+ (1,0) [0|1] "" STM32_LEFT,STM32_RIGHT,ESP32_AUX

BO_ 288 AuxLighting: 4 RPI
 SG_ FrontLight : 0|8@1+ (1,0) [0|100] "%" ESP32_AUX
 SG_ RearLight : 8|8@1+ (1,0) [0|100] "%" ESP32_AUX
